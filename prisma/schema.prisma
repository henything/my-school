generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COACH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ChildStatus {
  ACTIVE
  PAUSED
  LEFT
  TRIAL
  ARCHIVED
}

enum AdmissionStatus {
  ADMITTED
  CREDIT_LESSON_USED
  NOT_ADMITTED
}

enum PaymentStatus {
  NOT_INVOICED
  INVOICED
  NOT_PAID
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum LessonStatus {
  SCHEDULED
  ATTENDANCE_PENDING
  ATTENDANCE_COMPLETED
  MOVED
  CANCELLED
}

enum LessonChangeReason {
  QUARANTINE
  KINDERGARTEN_EVENT
  RUSSIAN_HOLIDAY
  COACH_UNAVAILABLE
  GROUP_TRANSFER
  OTHER
}

enum CoachAttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT_UNEXCUSED
  ABSENT_SICK_PENDING
}

enum AdminFinalAttendanceStatus {
  ABSENT_SICK_CONFIRMED
  ABSENT_VACATION_APPROVED
  ABSENT_QUARANTINE
  ABSENT_EVENT
  ABSENT_UNEXCUSED_FINAL
}

enum MakeupReason {
  SICKNESS
  VACATION
  QUARANTINE
  KINDERGARTEN_EVENT
  RUSSIAN_HOLIDAY
  COACH_UNAVAILABLE
  GROUP_TRANSFER
  OTHER
}

enum MakeupStatus {
  AVAILABLE
  ASSIGNED
  USED
  REFUNDED
  CANCELLED
}

enum GroupEventActionType {
  MAKEUP_AND_CANCEL_LESSONS
}

enum BalanceType {
  LESSON_BALANCE
  MAKEUP_BALANCE
}

enum BalanceTransactionType {
  SUBSCRIPTION_CREATED
  PRESENT_DEDUCTION
  UNEXCUSED_ABSENCE_DEDUCTION
  SICKNESS_MAKEUP_CREATED
  VACATION_MAKEUP_CREATED
  QUARANTINE_MAKEUP_CREATED
  EVENT_MAKEUP_CREATED
  CREDIT_LESSON_USED
  MAKEUP_USED
  MANUAL_ADJUSTMENT
  ATTENDANCE_DEDUCTION_REVERSAL
}

enum TaskPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
}

enum TaskType {
  ATTENDANCE_NOT_FILLED
  CHILD_TOOK_CREDIT_LESSON
  CHILD_NOT_ADMITTED
  SICKNESS_FOLLOW_UP
  CERTIFICATE_PENDING
  MAKEUP_NEEDS_ASSIGNMENT
  GROUP_OVER_CAPACITY
  TRIAL_NEEDS_PROCESSING
  ABSENCE_NEEDS_FINALIZATION
  COACH_SUBSTITUTION_ASSIGNED
  CHILD_WITHOUT_ACTIVE_SUBSCRIPTION
  MANUAL_TASK
}

enum TrialStatus {
  TRIAL_BOOKED
  TRIAL_ATTENDED
  TRIAL_NO_SHOW
  CONTACT_COLLECTED
  TRANSFERRED_TO_ADMIN
  CONVERTED_TO_ACTIVE
}

enum TrialSource {
  VK
  REFERRAL
  KINDERGARTEN
  ADVERTISING
  OTHER
  UNKNOWN
}

model School {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users         User[]
  adminProfiles AdminProfile[]
  coachProfiles CoachProfile[]
  branches      Branch[]
  parents       Parent[]
  children      Child[]
  groups        TrainingGroup[]
  scheduleTemplates ScheduleTemplate[]
  lessons       Lesson[]
  subscriptions Subscription[]
  lessonBalanceTransactions LessonBalanceTransaction[]
  makeupCredits MakeupCredit[]
  groupEvents   GroupEvent[]
  sessions      Session[]
  tasks         Task[]
  auditLogs     AuditLog[]
  trialParticipants TrialParticipant[]

  @@map("schools")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  schoolId     String     @map("school_id") @db.Uuid
  login        String
  passwordHash String     @map("password_hash")
  role         UserRole
  status       UserStatus @default(ACTIVE)
  displayName  String     @map("display_name")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  adminProfile  AdminProfile?
  coachProfile  CoachProfile?
  sessions      Session[]
  assignedTasks Task[]        @relation("TaskAssignee")
  closedTasks   Task[]        @relation("TaskClosedBy")
  markedAttendance AttendanceRecord[] @relation("AttendanceMarkedBy")
  finalizedAttendance AttendanceRecord[] @relation("AttendanceFinalizedBy")
  createdSubscriptions Subscription[] @relation("SubscriptionCreatedBy")
  createdBalanceTransactions LessonBalanceTransaction[] @relation("BalanceTransactionCreatedBy")
  createdMakeupCredits MakeupCredit[] @relation("MakeupCreditCreatedBy")
  createdGroupEvents GroupEvent[] @relation("GroupEventCreatedBy")
  createdTrialParticipants TrialParticipant[] @relation("TrialParticipantCreatedBy")
  auditLogs     AuditLog[]    @relation("AuditActor")

  @@unique([schoolId, login])
  @@index([schoolId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model AdminProfile {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([schoolId])
  @@map("admin_profiles")
}

model CoachProfile {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user   User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  groups TrainingGroup[]
  scheduleTemplates ScheduleTemplate[]
  lessons Lesson[] @relation("LessonCoach")
  substituteLessons Lesson[] @relation("LessonSubstituteCoach")
  trialParticipants TrialParticipant[]

  @@index([schoolId])
  @@map("coach_profiles")
}

model Branch {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  name           String
  address        String?
  status         EntityStatus @default(ACTIVE)
  inventoryNotes String?      @map("inventory_notes")
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  school School          @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  groups TrainingGroup[]
  scheduleTemplates ScheduleTemplate[]
  lessons Lesson[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([status])
  @@map("branches")
}

model Parent {
  id           String   @id @default(uuid()) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  fullName     String?  @map("full_name")
  phone        String?
  vkProfileUrl String?  @map("vk_profile_url")
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school   School  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  children Child[]

  @@index([schoolId])
  @@index([phone])
  @@map("parents")
}

model Child {
  id                  String          @id @default(uuid()) @db.Uuid
  schoolId            String          @map("school_id") @db.Uuid
  parentId            String?         @map("parent_id") @db.Uuid
  currentGroupId      String?         @map("current_group_id") @db.Uuid
  fullName            String          @map("full_name")
  birthDate           DateTime?       @map("birth_date") @db.Date
  status              ChildStatus     @default(ACTIVE)
  medicalNotes        String?         @map("medical_notes")
  coachComment        String?         @map("coach_comment")
  adminComment        String?         @map("admin_comment")
  admissionStatus     AdmissionStatus @default(ADMITTED) @map("admission_status")
  cachedLessonBalance Int             @default(0) @map("cached_lesson_balance")
  cachedMakeupBalance Int             @default(0) @map("cached_makeup_balance")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  parent       Parent?        @relation(fields: [parentId], references: [id], onDelete: SetNull)
  currentGroup TrainingGroup? @relation("CurrentGroup", fields: [currentGroupId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  subscriptions Subscription[]
  lessonBalanceTransactions LessonBalanceTransaction[]
  makeupCredits MakeupCredit[]
  convertedTrials TrialParticipant[] @relation("TrialConvertedChild")
  tasks        Task[]

  @@index([schoolId])
  @@index([parentId])
  @@index([currentGroupId])
  @@index([status])
  @@index([admissionStatus])
  @@index([fullName])
  @@map("children")
}

model TrainingGroup {
  id             String       @id @default(uuid()) @db.Uuid
  schoolId       String       @map("school_id") @db.Uuid
  branchId       String       @map("branch_id") @db.Uuid
  mainCoachId    String       @map("main_coach_id") @db.Uuid
  name           String
  status         EntityStatus @default(ACTIVE)
  capacityLimit  Int          @default(15) @map("capacity_limit")
  inventoryNotes String?      @map("inventory_notes")
  comment        String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  branch    Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  mainCoach CoachProfile @relation(fields: [mainCoachId], references: [id], onDelete: Restrict)
  children  Child[]      @relation("CurrentGroup")
  scheduleTemplates ScheduleTemplate[]
  lessons Lesson[]
  tasks     Task[]
  makeupCredits MakeupCredit[]
  groupEvents   GroupEvent[]
  trialParticipants TrialParticipant[]

  @@unique([branchId, name])
  @@index([schoolId])
  @@index([branchId])
  @@index([mainCoachId])
  @@index([status])
  @@map("groups")
}

model ScheduleTemplate {
  id        String       @id @default(uuid()) @db.Uuid
  schoolId  String       @map("school_id") @db.Uuid
  groupId   String       @map("group_id") @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  coachId   String       @map("coach_id") @db.Uuid
  weekday   Int
  startTime String       @map("start_time")
  endTime   String       @map("end_time")
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group   TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branch  Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coach   CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Restrict)
  lessons Lesson[]

  @@unique([groupId, weekday, startTime])
  @@index([schoolId])
  @@index([groupId])
  @@index([branchId])
  @@index([coachId])
  @@index([status])
  @@map("schedule_templates")
}

model Lesson {
  id                 String              @id @default(uuid()) @db.Uuid
  schoolId           String              @map("school_id") @db.Uuid
  groupId            String              @map("group_id") @db.Uuid
  branchId           String              @map("branch_id") @db.Uuid
  coachId            String              @map("coach_id") @db.Uuid
  substituteCoachId  String?             @map("substitute_coach_id") @db.Uuid
  scheduleTemplateId String?             @map("schedule_template_id") @db.Uuid
  lessonDate         DateTime            @map("lesson_date") @db.Date
  startTime          String              @map("start_time")
  endTime            String              @map("end_time")
  status             LessonStatus        @default(SCHEDULED)
  changeReason       LessonChangeReason? @map("change_reason")
  changeComment      String?             @map("change_comment")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group            TrainingGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  branch           Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  coach            CoachProfile      @relation("LessonCoach", fields: [coachId], references: [id], onDelete: Restrict)
  substituteCoach  CoachProfile?     @relation("LessonSubstituteCoach", fields: [substituteCoachId], references: [id], onDelete: SetNull)
  scheduleTemplate ScheduleTemplate? @relation(fields: [scheduleTemplateId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[]
  lessonBalanceTransactions LessonBalanceTransaction[]
  sourceMakeupCredits MakeupCredit[] @relation("MakeupCreditSourceLesson")
  assignedMakeupCredits MakeupCredit[] @relation("MakeupCreditAssignedLesson")
  trialParticipants TrialParticipant[]

  @@unique([groupId, lessonDate, startTime])
  @@index([schoolId])
  @@index([groupId])
  @@index([branchId])
  @@index([coachId])
  @@index([substituteCoachId])
  @@index([scheduleTemplateId])
  @@index([lessonDate])
  @@index([status])
  @@map("lessons")
}

model AttendanceRecord {
  id                String                      @id @default(uuid()) @db.Uuid
  lessonId          String                      @map("lesson_id") @db.Uuid
  childId           String                      @map("child_id") @db.Uuid
  status            CoachAttendanceStatus       @default(NOT_MARKED)
  finalStatus       AdminFinalAttendanceStatus? @map("final_status")
  markedByUserId    String?                     @map("marked_by_user_id") @db.Uuid
  markedAt          DateTime?                   @map("marked_at")
  finalizedByUserId String?                     @map("finalized_by_user_id") @db.Uuid
  finalizedAt       DateTime?                   @map("finalized_at")
  comment           String?
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  lesson             Lesson                     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  child              Child                      @relation(fields: [childId], references: [id], onDelete: Restrict)
  markedBy           User?                      @relation("AttendanceMarkedBy", fields: [markedByUserId], references: [id], onDelete: SetNull)
  finalizedBy        User?                      @relation("AttendanceFinalizedBy", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  balanceTransactions LessonBalanceTransaction[]
  makeupCredits MakeupCredit[]

  @@unique([lessonId, childId])
  @@index([lessonId])
  @@index([childId])
  @@index([status])
  @@index([finalStatus])
  @@index([markedByUserId])
  @@index([finalizedByUserId])
  @@map("attendance_records")
}

model Subscription {
  id                  String        @id @default(uuid()) @db.Uuid
  schoolId            String        @map("school_id") @db.Uuid
  childId             String        @map("child_id") @db.Uuid
  periodStart         DateTime      @map("period_start") @db.Date
  periodEnd           DateTime      @map("period_end") @db.Date
  plannedLessonsCount Int           @map("planned_lessons_count")
  lessonPriceKopeks   Int           @default(45000) @map("lesson_price_kopeks")
  totalAmountKopeks   Int           @map("total_amount_kopeks")
  paymentStatus       PaymentStatus @default(NOT_INVOICED) @map("payment_status")
  paymentStatusChangedAt DateTime?  @map("payment_status_changed_at")
  paymentStatusComment   String?    @map("payment_status_comment")
  createdByUserId     String        @map("created_by_user_id") @db.Uuid
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  school              School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  child               Child                      @relation(fields: [childId], references: [id], onDelete: Restrict)
  createdBy           User                       @relation("SubscriptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  balanceTransactions LessonBalanceTransaction[]

  @@index([schoolId])
  @@index([childId])
  @@index([createdByUserId])
  @@index([paymentStatus])
  @@index([periodStart, periodEnd])
  @@map("subscriptions")
}

model MakeupCredit {
  id                       String       @id @default(uuid()) @db.Uuid
  schoolId                 String       @map("school_id") @db.Uuid
  childId                  String       @map("child_id") @db.Uuid
  groupId                  String       @map("group_id") @db.Uuid
  sourceLessonId           String?      @map("source_lesson_id") @db.Uuid
  sourceAttendanceRecordId String?      @map("source_attendance_record_id") @db.Uuid
  groupEventId             String?      @map("group_event_id") @db.Uuid
  reason                   MakeupReason
  status                   MakeupStatus @default(AVAILABLE)
  assignedLessonId         String?      @map("assigned_lesson_id") @db.Uuid
  assignedDate             DateTime?    @map("assigned_date") @db.Date
  createdByUserId          String?      @map("created_by_user_id") @db.Uuid
  comment                  String?
  usedAt                   DateTime?    @map("used_at")
  refundedAt               DateTime?    @map("refunded_at")
  cancelledAt              DateTime?    @map("cancelled_at")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  school                 School                     @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  child                  Child                      @relation(fields: [childId], references: [id], onDelete: Restrict)
  group                  TrainingGroup              @relation(fields: [groupId], references: [id], onDelete: Restrict)
  sourceLesson           Lesson?                    @relation("MakeupCreditSourceLesson", fields: [sourceLessonId], references: [id], onDelete: SetNull)
  sourceAttendanceRecord AttendanceRecord?          @relation(fields: [sourceAttendanceRecordId], references: [id], onDelete: SetNull)
  groupEvent             GroupEvent?                @relation(fields: [groupEventId], references: [id], onDelete: SetNull)
  assignedLesson         Lesson?                    @relation("MakeupCreditAssignedLesson", fields: [assignedLessonId], references: [id], onDelete: SetNull)
  createdBy              User?                      @relation("MakeupCreditCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  balanceTransactions    LessonBalanceTransaction[]

  @@unique([childId, sourceLessonId, reason])
  @@unique([childId, sourceAttendanceRecordId, reason])
  @@index([schoolId])
  @@index([childId])
  @@index([groupId])
  @@index([sourceLessonId])
  @@index([sourceAttendanceRecordId])
  @@index([groupEventId])
  @@index([status])
  @@index([reason])
  @@index([assignedLessonId])
  @@map("makeup_credits")
}

model GroupEvent {
  id              String               @id @default(uuid()) @db.Uuid
  schoolId        String               @map("school_id") @db.Uuid
  groupId         String               @map("group_id") @db.Uuid
  reason          LessonChangeReason
  actionType      GroupEventActionType @default(MAKEUP_AND_CANCEL_LESSONS) @map("action_type")
  periodStart     DateTime             @map("period_start") @db.Date
  periodEnd       DateTime             @map("period_end") @db.Date
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  comment         String?
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  group         TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy     User          @relation("GroupEventCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  makeupCredits MakeupCredit[]

  @@index([schoolId])
  @@index([groupId])
  @@index([reason])
  @@index([periodStart, periodEnd])
  @@map("group_events")
}

model LessonBalanceTransaction {
  id                 String                 @id @default(uuid()) @db.Uuid
  schoolId           String                 @map("school_id") @db.Uuid
  childId            String                 @map("child_id") @db.Uuid
  lessonId           String?                @map("lesson_id") @db.Uuid
  attendanceRecordId String?                @map("attendance_record_id") @db.Uuid
  subscriptionId     String?                @map("subscription_id") @db.Uuid
  makeupCreditId     String?                @map("makeup_credit_id") @db.Uuid
  type               BalanceTransactionType
  balanceType        BalanceType            @map("balance_type")
  amount             Int
  reason             String?
  createdByUserId    String?                @map("created_by_user_id") @db.Uuid
  comment            String?
  createdAt          DateTime               @default(now()) @map("created_at")

  school           School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  child            Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  lesson           Lesson?           @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  subscription     Subscription?     @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  makeupCredit     MakeupCredit?     @relation(fields: [makeupCreditId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation("BalanceTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([childId])
  @@index([lessonId])
  @@index([attendanceRecordId])
  @@index([subscriptionId])
  @@index([makeupCreditId])
  @@index([type])
  @@index([balanceType])
  @@index([createdAt])
  @@map("lesson_balance_transactions")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id                String       @id @default(uuid()) @db.Uuid
  schoolId          String       @map("school_id") @db.Uuid
  type              TaskType
  priority          TaskPriority
  assigneeUserId    String?      @map("assignee_user_id") @db.Uuid
  relatedEntityType String?      @map("related_entity_type")
  relatedEntityId   String?      @map("related_entity_id") @db.Uuid
  title             String
  description       String?
  status            TaskStatus   @default(OPEN)
  dueAt             DateTime?    @map("due_at")
  closedAt          DateTime?    @map("closed_at")
  closedByUserId    String?      @map("closed_by_user_id") @db.Uuid
  closedComment     String?      @map("closed_comment")
  childId           String?      @map("child_id") @db.Uuid
  groupId           String?      @map("group_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  assigneeUser User?          @relation("TaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  closedByUser User?          @relation("TaskClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  child        Child?         @relation(fields: [childId], references: [id], onDelete: SetNull)
  group        TrainingGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([assigneeUserId])
  @@index([type])
  @@index([priority])
  @@index([status])
  @@index([dueAt])
  @@index([schoolId, status, priority, dueAt])
  @@index([relatedEntityType, relatedEntityId])
  @@index([childId])
  @@index([groupId])
  @@map("tasks")
}

model TrialParticipant {
  id               String      @id @default(uuid()) @db.Uuid
  schoolId         String      @map("school_id") @db.Uuid
  lessonId         String      @map("lesson_id") @db.Uuid
  groupId          String      @map("group_id") @db.Uuid
  coachId          String      @map("coach_id") @db.Uuid
  convertedChildId String?     @map("converted_child_id") @db.Uuid
  childName        String?     @map("child_name")
  childAge         Int?        @map("child_age")
  parentName       String?     @map("parent_name")
  parentPhone      String?     @map("parent_phone")
  parentVkUrl      String?     @map("parent_vk_url")
  source           TrialSource @default(UNKNOWN)
  status           TrialStatus @default(TRIAL_BOOKED)
  comment          String?
  createdByUserId  String?     @map("created_by_user_id") @db.Uuid
  convertedAt      DateTime?   @map("converted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  school         School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  lesson         Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  group          TrainingGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  coach          CoachProfile  @relation(fields: [coachId], references: [id], onDelete: Restrict)
  convertedChild Child?        @relation("TrialConvertedChild", fields: [convertedChildId], references: [id], onDelete: SetNull)
  createdBy      User?         @relation("TrialParticipantCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([lessonId])
  @@index([groupId])
  @@index([coachId])
  @@index([status])
  @@index([convertedChildId])
  @@index([createdByUserId])
  @@index([schoolId, status])
  @@map("trial_participants")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  actor  User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
